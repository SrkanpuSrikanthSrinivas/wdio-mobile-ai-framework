# Copy this to ".env" and fill it in. Never committed.

# --- Your AI key (free Groq recommended). Shared or your own — both work. ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- Your name (shows on the BrowserStack dashboard so the host sees your run) ---
PARTICIPANT=

# --- BrowserStack (the host shares these three) ---
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BSTACK_APP=bs://<app-id-the-host-uploaded>

# --- Free Gemini key (recommended AI for aider): https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
