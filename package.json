{
  "name": "wdio-mobile-ai-framework",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium mobile test framework with an AI-CLI workflow and a device-free validation gate",
  "type": "module",
  "scripts": {
    "ai": "node scripts/ai.mjs",
    "ai:groq": "node scripts/ai.mjs groq",
    "android": "wdio run config/wdio.android.conf.js",
    "get-app": "bash scripts/get-app.sh",
    "verify": "node scripts/verify.mjs",
    "validate": "node --test test/helpers/*.test.js app/src/*.test.js && node scripts/check-syntax.mjs && node scripts/check-imports.mjs && node scripts/check-locators.mjs",
    "check": "node scripts/check-syntax.mjs",
    "tok:stats": "toklite stats",
    "tok:verify": "toklite verify",
    "tok:doctor": "toklite doctor",
    "demo:savings": "node scripts/demo-toklite-savings.mjs",
    "android:cloud": "wdio run config/wdio.browserstack.conf.js",
    "add:local-appium": "npm i -D @wdio/appium-service appium appium-uiautomator2-driver",
    "setup": "node scripts/setup.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:locators": "node scripts/check-locators.mjs",
    "run:local": "bash scripts/run-local.sh",
    "run:cloud": "bash scripts/run-cloud.sh",
    "ai:gemini": "node scripts/ai.mjs gemini",
    "ai:local": "node scripts/ai.mjs ollama"
  },
  "keywords": [
    "webdriverio",
    "appium",
    "android",
    "mobile-testing",
    "test-automation",
    "ai-cli",
    "aider"
  ],
  "license": "MIT",
  "devDependencies": {
    "@wdio/browserstack-service": "^9.33.2",
    "@wdio/cli": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0"
  },
  "author": "Srikanth Srinivas",
  "repository": {
    "type": "git",
    "url": "https://github.com/SrkanpuSrikanthSrinivas/wdio-mobile-ai-framework.git"
  }
}
